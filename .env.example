# ── HomeFront Fiber — production environment ──────────────────────────────────
# Copy to .env on the server and fill in real values. NEVER commit the real .env.

# App
NODE_ENV=production
PORT=5000
# SQLite database file. Defaults to ./data.db if unset.
DB_PATH=/srv/homefront/data.db
# Your public domain — used for CORS/CSP allowlisting. No trailing slash.
APP_ORIGIN=https://portal.homefrontsolutionsllc.com
# Server-owned tenant for applications from www.homefrontsolutionsllc.com/careers.
# Applicants cannot override this mapping from the browser.
CAREERS_TENANT_SLUG=home-front-solutions
# Development/E2E only: records delivery metadata without contacting Resend.
# Ignored when NODE_ENV=production.
RESEND_DELIVERY_MODE=
# Optional: extra allowed origins (comma-separated) for CORS, e.g. staging.
# EXTRA_ORIGINS=https://staging.homefrontsolutionsllc.com
# Optional: origins allowed to iframe-embed the app (CSP frame-ancestors).
# EMBED_ANCESTORS=
# Reverse-proxy hops to trust for the real client IP (1 = one proxy, typical).
TRUST_PROXY=1

# ── Mapbox — TWO separate tokens (keep them separate to control cost) ─────────
# 1) PUBLIC token for the map basemap + pins. Sent to the browser, so in the
#    Mapbox dashboard restrict it to your domain(s) and scope it to
#    styles:read + tiles:read ONLY (no geocoding). Map Loads are 50k/mo free.
MAPBOX_PUBLIC_TOKEN=pk.xxxxxxxx
# 2) SECRET token for server-side address geocoding (never sent to the browser).
#    A normal field box automatically unions a capped Mapbox grid with OSM/GIS;
#    leave unset to run mapped sources only. Geocoding is billed per request.
MAPBOX_TOKEN=sk.xxxxxxxx
# Hard cap on grid points (billable requests) per Mapbox harvest. Default 5000.
# MAPBOX_HARVEST_CAP=5000
# Maximum planned grid calls automatically added to one drawn-box scan. Boxes
# above this budget use OSM/GIS only rather than silently coarsening or overspending.
# AREA_AUTO_GRID_POINTS=900
# Conservative field-map address enumeration controls.
# MAPBOX_DISCOVERY_MIN_INTERVAL_MS=500
# MAPBOX_REVERSE_CONCURRENCY=6
# MAPBOX_REVERSE_BATCH_DELAY_MS=150
# ── Optional authorized fixed-egress proxy ───────────────────────────────────
# Use only when permitted by the upstream agreement. This transport does not
# rotate identities or bypass access controls and may be billed per GB.
# Either provide one URL, or keep credentials split so secrets never need to be
# interpolated in deployment configuration. PROXY_URL takes precedence.
PROXY_URL=http://user:pass@gate.decodo.com:port
# DECODO_HOST=us.decodo.com
# DECODO_PORT=10000
# DECODO_USER=
# DECODO_PASS=
# DECODO_PROTOCOL=http
# PROXY_POOL_CONNECTIONS=100
# PROXY_PIPELINING=1
# Proactive Decodo session rotation cadence (requests per egress-IP set). Default
# 20 with the unlimited-budget posture: fresh residential IPs are free, throttled
# IPs are not. TUNING NOTE: upstream pacing is intentionally removed — Kinetic-side
# 403s are absorbed purely by session rotation. If you ever see rotation storms in
# the logs (`[proxy-fetch] Decodo session rotated` many times per second), dial
# PROXY_ROTATE_EVERY DOWN (e.g. 20 → 10, more rotation) rather than re-adding rate
# caps. Direct-request count must remain zero; never set ALLOW_DIRECT_EGRESS=true
# in production.
# PROXY_ROTATE_EVERY=20

# One distributed provider queue shared by manual, area, city, Coming Soon, and
# nightly work. Every app instance must use the same DATA_DIR/SQLite database.
# This is NOT a scans/hour limit: authorized users may enqueue continuously. It
# caps only simultaneous upstream checks so parallel jobs do not multiply into
# a 403 storm. Increase gradually using /api/scanner/state block/error metrics.
# SCAN_PROVIDER_CONCURRENCY limits local DB waiters; SCAN_GLOBAL_CONCURRENCY is
# the authoritative cross-instance search ceiling (clamped to 50).
# SCAN_PROVIDER_CONCURRENCY=50
# SCAN_GLOBAL_CONCURRENCY=50
# One database-backed aggregate rolling-minute budget across every process,
# scanner type, token, and proxy connection.
# SCAN_PROVIDER_REQUESTS_PER_MINUTE=100
# KFS_TOKEN_POOL_MAX=100
# KFS_TOKEN_POOL_WARM_MIN=2
# KFS_TOKEN_MAX_CHECKS=100
# KFS_TOKEN_MAX_LEASES_PER_SLOT=10
# KFS_TOKEN_REFRESH_CONCURRENCY=2
# KFS_TOKEN_MAINTENANCE_MS=15000
# KINETIC_RECHECK_CONCURRENCY=50
# Reuse recent conclusive address answers; failures/throttles are never cached.
# SCAN_RESULT_CACHE_MS=300000
# SCAN_RESULT_CACHE_MAX=20000

# ── Kinetic evidence scanner ──────────────────────────────────────────────────
# The scanner mints a short-lived session token from
# https://buy.gokinetic.com/api/v1/auth/session?context=web (override with
# KFS_AUTH_URL), caches it in server memory, refreshes 60s before expiry, and
# calls /api/v1/address/search. Tokens never leave server memory, logs, or the
# database. The token pool auto-warms at boot, so whether live lookups actually
# happen depends on a working Decodo / curl-impersonate egress reaching the
# token endpoint — NOT on the flag below.
#
# KFS_AUTOMATION_AUTHORIZED is NOT a hard on/off gate for minting or scanning.
# (An earlier revision refused to mint unless it was "true"; production never
# set it, so the pool could never warm and every address sat unresolved — that
# was the defect.) It now only drives a per-address fast-skip when the pool is
# ALSO empty, plus token-status reporting. The real safety property is unchanged
# and lives in scanAddressDirect, which fails CLOSED (unresolved, never a false
# "no service") whenever no authorized session can be obtained.
KFS_AUTOMATION_AUTHORIZED=false
# Optional partner/staging override for the token endpoint. Production leaves unset.
# KFS_AUTH_URL=https://buy.gokinetic.com/api/v1/auth/session?context=web
# KINETIC_EVIDENCE_CACHE_MS=300000
# KINETIC_VERIFICATION_CONFIRMATIONS=2

# ── Evidence-backed NC/SC/GA state monitor ───────────────────────────────────
# The durable scheduler is ON by default (set ENABLE_STATE_MONITORING=off to
# disable it). Because the operator runs scanning continuously, live provider
# spend is ALSO on by default (set STATE_MONITOR_LIVE=off to keep the scheduler
# but stop spending checks). Spend is bounded by the daily/market budgets below,
# not by an off-by-default gate. Keep one authorized provider identity;
# challenges are inconclusive and trigger backoff, never CAPTCHA bypass,
# rotating identities, or deceptive headers.
# ENABLE_STATE_MONITORING=off   # uncomment to turn the scheduler off entirely
# STATE_MONITOR_LIVE=off        # uncomment to run the scheduler without spend
# STATE_MONITOR_TICK_MINUTES=60
# STATE_MONITOR_DAILY_CHECK_BUDGET=2000
# STATE_MONITOR_MARKET_BUDGET=250
# ENABLE_STATE_ADDRESS_HARVEST=false
# Harvest one verified market per scheduler tick while inventory gaps remain.
# This runs alongside (and never replaces) an eligible provider scan.
# STATE_MONITOR_INVENTORY_EVERY_TICKS=1
# Weekly carrier-owned market directory and official Uniti announcement watch.
# ENABLE_KINETIC_DIRECTORY_WATCH=true
# ENABLE_ANNOUNCEMENT_WATCH=true
# Optional immediate confirmed-cluster delivery. Webhook receivers must honor the
# Idempotency-Key header. Email uses the SMTP/MAIL_ADMIN settings below.
# FRESH_FIBER_WEBHOOK_URL=https://your-automation.example/fresh-fiber

# Shared secret for the standalone bookmarklet scanner submit endpoint.
# Generate locally (never paste the value into chat/docs):  openssl rand -hex 32
SCANNER_SUBMIT_SECRET=change-me-to-a-long-random-string

# ── Email via Resend (SMTP). Without these, OTP codes print to the server log. ─
# Resend SMTP is a drop-in for nodemailer. The app derives TLS from the port
# (465 = implicit TLS). SMTP_USER is the literal "resend"; SMTP_PASS is a Resend
# API key (create at https://resend.com/api-keys). MAIL_FROM must be a Resend-
# VERIFIED sender on your domain — never SMTP_USER. Your domain already has the
# Resend DKIM/SPF records, so mail from @homefrontsolutionsllc.com authenticates.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
MAIL_FROM=Home Front Solutions <noreply@portal.homefrontsolutionsllc.com>
# The first-party onboarding-signature service uses Resend's HTTPS Email API.
# It prefers RESEND_API_KEY/RESEND_FROM, and safely reuses SMTP_PASS/MAIL_FROM
# above when SMTP_HOST is smtp.resend.com.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Home Front Solutions <noreply@portal.homefrontsolutionsllc.com>
# Admin-notification recipient (territory requests, applications, cron alerts).
# Defaults to the first SUPER_ADMIN_EMAILS entry if unset.
MAIL_ADMIN=admin@homefrontsolutionsllc.com
#
# (Gmail alternative: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
#  SMTP_PASS=<app password from https://myaccount.google.com/apppasswords>,
#  MAIL_FROM unset — with Gmail the username IS the sender address.)

# Comma-separated emails granted super-admin (SaaS tenant control)
SUPER_ADMIN_EMAILS=you@homefrontsolutionsllc.com

# ── Stripe billing + rep payouts ─────────────────────────────────────────────
# Use test keys until a complete end-to-end payout has been verified. The same
# platform secret funds both SaaS billing and Connect transfers. Rep onboarding
# is Stripe-hosted; never store bank details in this app.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional SaaS subscription prices (not required for rep payouts).
# STRIPE_PRICE_STARTER=price_xxxxxxxx
# STRIPE_PRICE_GROWTH=price_xxxxxxxx
# STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxx

# ── Home Front Sign ─────────────────────────────────────────────────────────
# No paid e-signature vendor is required. The server snapshots every agreement,
# hashes it, records authenticated consent and signer intent, creates the signed
# PDF/certificate, and retains a hash-chained event history for seven years.
# APP_ORIGIN must be the public HTTPS portal origin used in Resend invitations.
# HMAC key for private candidate invitation links. Generate once and keep stable:
# openssl rand -hex 32
ONBOARDING_INVITE_SECRET=replace-with-at-least-32-random-characters

# ── Continuous DB backup (Litestream → S3-compatible object storage) ──────────
# STRONGLY RECOMMENDED before real data lands. Without LITESTREAM_BUCKET the app
# still runs but deploy/start.sh warns loudly and there is NO continuous backup —
# the SQLite DB lives only on the server volume. Point at Backblaze B2 or
# Cloudflare R2 (see deploy/litestream.yml + docs/DEPLOYMENT.md §Backups).
LITESTREAM_BUCKET=hfs-portal-backup
LITESTREAM_ENDPOINT=https://s3.us-east-005.backblazeb2.com
LITESTREAM_ACCESS_KEY_ID=your-b2-key-id
LITESTREAM_SECRET_ACCESS_KEY=your-b2-application-key

# ── Compliance-gated manual Calling (dark/off by default) ───────────────────
# Calling is a separate, pilot-only capability. Keep every switch off and the
# emergency stop on until legal/provider/DNC setup in docs/CALLING_COMPLIANCE.md
# is complete. Generic reps and Field Map never receive full phone numbers.
CALLING_MODULE_ENABLED=false
CONTACT_ENRICHMENT_ENABLED=false
NATIONAL_DNC_ENABLED=false
STATE_RULES_ENABLED=false
MANUAL_CLICK_TO_CALL_ENABLED=false
CALLING_EMERGENCY_DISABLED=true
# ── Browser softphone (Telnyx WebRTC) ────────────────────────────────────────
# Optional. When BOTH values are set, click-to-call is offered: the rep's
# browser dials via a Telnyx softphone instead of revealing the number to
# hand-dial. Unset = the module still works via reveal-and-hand-dial (the
# `voiceProviderReady` status flag reports which mode is live). This changes the
# TRANSPORT only, never the posture: still one rep-initiated call per lead, no
# auto-advance, no predictive dialing.
#   TELNYX_API_KEY            - a Telnyx V2 API key (server-only; never shipped
#                               to the browser). Used solely to mint short-lived
#                               softphone registration JWTs.
#   TELNYX_WEBRTC_CREDENTIAL_ID - the id of a Telnyx Telephony (On-Demand)
#                               Credential tied to a Credential SIP Connection.
#                               The connection's voice profile owns the outbound
#                               caller-id/from-number, matching the calling
#                               profile's authorized caller-id.
TELNYX_API_KEY=
TELNYX_WEBRTC_CREDENTIAL_ID=
# Legacy aliases FEDERAL_DNC_ENABLED and STATE_DNC_ENABLED are read only for
# backward compatibility. Leave them unset and use the canonical flags above.
# Comma-separated tenant IDs explicitly approved for the limited pilot.
CALLING_PILOT_ORG_IDS=
# Five independent 32-byte values: `openssl rand -hex 32` for each. Store real
# values only in the deployment secret manager; never commit them.
CALLING_DATA_ENCRYPTION_KEY=
# Pay-plane encryption key (contractor bank details, W-9 TINs, company EIN/DFI
# account at rest). Own 32-byte slot — `openssl rand -hex 32` — separate from
# the calling key so the money plane rotates independently. Ciphertext is
# key-id-stamped (v1.pay.* vs v1.calling.*), so setting this AFTER rows were
# written under the calling-key fallback does NOT strand them. When unset the
# calling key above is used as the fallback so a single-secret install boots.
PAY_CRYPTO_KEY=
PHONE_HASH_KEY=
CALL_AUTHORIZATION_SIGNING_KEY=
# Verifies manifests produced from an organization-authorized DNC export. The
# signing tool is `npm run calling:dnc:sign`; never expose this key to browsers.
DNC_IMPORT_MANIFEST_SIGNING_KEY=
# Production always rejects the legacy direct-import route. Keep this false in
# every environment except an isolated local test that explicitly needs it.
DNC_ALLOW_DIRECT_IMPORT=false
# Verifies artifact manifests from a separate trusted immutable-storage
# attestor. This repository does not contain that uploader/attestor, so setting
# this key alone does not make consent capture production-ready.
CONSENT_ARTIFACT_MANIFEST_SIGNING_KEY=

# Bounded to 30..300 seconds by the server; default 120 seconds.
CALL_AUTHORIZATION_TTL_SECONDS=120

# ── Area skip trace (Tracerfy) ───────────────────────────────────────────────
# Positive-form opt-in: anything other than the literal "true" leaves it off.
# The run also refuses unless TRACERFY_API_KEY is set.
AREA_SKIP_TRACE_ENABLED=false
TRACERFY_API_KEY=
# Optional override; defaults to https://api.tracerfy.com
# TRACERFY_BASE_URL=
# OPTIONAL. Traced doors enter the Cold Calling queue without this. The value
# is recorded on every compliance decision as provider_contract_ref and in audit
# exports, so set it to the real contract reference (e.g.
# contract://tracerfy/2026-msa) if you want those rows to name the agreement
# rather than the default "contract://tracerfy".
# TRACERFY_CONTRACT_REF=
# Doors per run. A larger area is refused with its count, never traced in part.
AREA_SKIP_TRACE_MAX_LEADS=250
# Numbers returned by one dialing-list read.
DIALING_LIST_MAX_PHONES=200

# CALLING_SIMPLE_MODE controls how many compliance rules the evaluator runs. It
# is read as (value !== "off"), so ANY other value — INCLUDING leaving it unset
# — selects SIMPLE mode. Set it explicitly so the production posture is a
# decision rather than an accident of an unset variable.
CALLING_SIMPLE_MODE=off
# ── PerfectVision submitted orders + order recovery ──────────────────────────
# The order-status plane: import the POE "Total Submitted Orders by Program"
# report, match every order to the sale it came from, and work the ones that
# stalled. See docs/integrations/perfectvision-submitted-orders-recovery.md.
#
# Both switches are POSITIVE-FORM opt-ins: anything other than the literal
# "true" leaves them off, so an unset variable is the safe state.

# Automated report retrieval. OFF, and it stays off until PerfectVision has
# authorized an export endpoint, an SFTP drop, or a scheduled report delivery
# for this dealer IN WRITING. The provider has no scraping path: with this on
# and no authorized delivery configured, a fetch still refuses. Manual CSV/XLSX
# upload needs neither this flag nor anything else.
PERFECTVISION_ORDER_SYNC_ENABLED=false

# Automated recovery messaging. OFF. Turning it on is necessary but NOT
# sufficient: the organization must also approve messaging, confirm a consent
# policy, configure a sender and a postal address, and approve each template,
# and every individual send still passes the consent and suppression gate.
# Manual, human-reviewed sends are gated on this flag too.
PERFECTVISION_ORDER_RECOVERY_MESSAGING_ENABLED=false

# AES-256-GCM key for the provider report and its rows at rest. Without it the
# uploaded file is NOT stored and the original row data is NOT retained - the
# import still runs, and the import record says so. Never store a provider
# report's customer data unencrypted.
#   openssl rand -hex 32
VENDOR_ORDER_ENCRYPTION_KEY=

# HMAC key for the consent and suppression lookup tokens. Without it those
# tables fall back to an unkeyed SHA-256 and record which scheme each row used,
# so opt-outs are still honoured; set it so the block list is not a
# brute-forceable list of reachable customers.
#   openssl rand -hex 32
VENDOR_CONTACT_HASH_KEY=

# Where the unsubscribe link in a recovery email points. Without it no email can
# render a working unsubscribe, so the gate refuses to send one.
PUBLIC_BASE_URL=

# Shared secret for the inbound SMS webhook that carries STOP replies. Unset
# means the endpoint answers 404 to everyone.
RECOVERY_SMS_WEBHOOK_SECRET=

# Kill switch for the background import worker. Any value other than "off"
# leaves it running in the control process.
# VENDOR_ORDER_WORKER=off

# ── Guarded actions ──────────────────────────────────────────────────────────
# The approval queue and undo journal in front of dangerous writes. Ships OFF:
# with this unset every /api/actions route answers 404 and any call site wired
# through the gate falls back to its previous behaviour, so turning it on is a
# deliberate act and turning it off is a rollback that needs no deploy.
#
# What it does NOT control: a kind's catalogue floor. Lifting a contact
# suppression always needs a second approver whatever an organization
# configures, and irreversible kinds are never offered an undo.
GUARDED_ACTIONS_ENABLED=false

# Reliability phase: disabled until the actual seven-day staging soak passes.
# Stable tenant cohorts for authenticated features; stable normalized-email
# cohorts for pre-auth OTP (known and unknown addresses are treated identically).
RELIABILITY_ROLLOUT_PERCENT=0
RELIABILITY_CANARY_TENANTS=
SCANNER_HEARTBEAT=true
COUNT_ATOMIC_UPDATES=true
IDEMPOTENT_EMAIL=true
IDEMPOTENT_ASSIGNMENT=true
OUTBOX_PATTERN=true
DEAD_LETTER_UI=true
# 32-byte hex key, provisioned through the deployment secret store; never commit.
# Existing CALLING_DATA_ENCRYPTION_KEY is a supported fallback. Preserve keys
# until protected codes and pending delivery payloads have expired/drained.
OTP_ENCRYPTION_KEY=
# Durable OTP requires the existing Resend HTTP key/from configuration in prod.
# SMTP is intentionally not a fallback for an ambiguous durable HTTP send.
# See docs/runbooks/reliability-hardening.md for compatibility rollback and gates.

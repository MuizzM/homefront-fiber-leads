# No trailing slash: with one, these match only directories, so a SYMLINK named
# node_modules is not ignored. That is how a self-referential node_modules link
# got committed once already — it resolves to itself on a checkout 
node_modules
node_modules/
dist/
.vite/

# Operator/runtime data dropped on the production host (not release content).
# The deploy's dirty-checkout guard ignores gitignored paths, so this keeps an
# on-host data folder from blocking releases while still catching real tampering.
ops-data/

# SQLite database files — never commit; exposes demo data at rest
# (data/* not data/, so the negated dataset below can survive the exclude)
data/*
# …except committed datasets the build ships (import-fcc-pins reads this one)
!data/fcc-additions-cabarrus-rowan-2025.json
# The Kinetic 2026 per-block footprint ships INSIDE the production image
# (script/build.ts copies it to dist/), so it has to be tracked. The raw
# per-location JSONL it was built from stays ignored - 40MB with no further use
# once the blocks are counted.
!data/kinetic-2026-footprint.json
data.db
data.db-shm
data.db-wal
data.db-journal

# Throwaway DATA_DIR for the `homefront-verify` launch config — a scratch
# database used to drive the app locally without contending for data.db.
.dev-verify/
# Local snapshots + the out-of-database high-water mark (server/dbSafetyNet.ts).
# Whole copies of the database, so this must stay ignored for exactly the reason
# the line above exists — and they are gigabyte-scale.
backups/

# Browser/E2E runtime artifacts
test-results/
playwright-report/
# Playwright-MCP console/page captures. These are recorded against a RUNNING
# app, so a capture can contain the x-session-id of whoever drove the browser -
# never release content, and never something to commit.
.playwright-mcp/

.env
.env.*
!.env.example

*.log
.DS_Store

# Uploaded rep photos/licenses (PII) — never commit
uploads/

# Production runtime/recovery state (never build or commit it)
backups/
.deployed-tag
.previous-tag
.backup-age-recipient
.backup-age-identity
# Deploy-pipeline runtime state (host-only): flock mutex + detached-run log/status/pid
.deploy.lock
.deploy-run/

# Local live-verification harnesses (reference proxy creds via shell env — never commit)
verify-*.ts
lexington-newbuilds.json

# Agent worktrees — transient scratch space created by Claude Code when a
# subagent runs in isolation. Never project content, and committing one would
# check a nested clone into the repo.
.claude/worktrees/
.prod-verify/

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-developer overrides. Shared
# Impeccable config, design context, live config, and critique reports remain
# trackable so every agent uses the same reviewed design decisions.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end
.dev-verify/logs/

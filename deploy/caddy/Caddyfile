# ── HomeFront Fiber — Caddy reverse proxy ────────────────────────────────────
# Automatic HTTPS (Let's Encrypt) + HTTP→HTTPS redirect are ON by default in
# Caddy — no extra config needed. Caddy renews certs automatically.
#
# DNS prerequisite: an A record for portal.homefrontsolutionsllc.com → server IP
# must resolve BEFORE first boot, or the ACME challenge fails. See docs/DNS.md.

portal.homefrontsolutionsllc.com {
	encode zstd gzip

	# TRACE/TRACK are diagnostic legacy methods and CONNECT is a proxy-tunnel
	# method. The portal uses none of them. Refuse them at the edge so they never
	# reach Express or fall through to the SPA; the application repeats the same
	# policy as defense in depth when it is reached without Caddy.
	@unsafe_methods method TRACE TRACK CONNECT
	respond @unsafe_methods 405

	# NEAR-ZERO-DOWNTIME CUTOVER. Without retry, the moment the app container
	# stops during a release Caddy fails the request outright — reps saw hard
	# connection errors for the length of the swap (measured: a multi-minute
	# outage while the release also took its backup inside that window).
	# lb_try_duration makes Caddy HOLD a request and keep retrying while the
	# replacement comes up, so a normal cutover is a slightly slow request
	# instead of an error. Active health checks keep an unhealthy upstream out
	# of rotation, and the passive fail policy stops hammering a dead one.
	reverse_proxy app:5000 {
		lb_try_duration 45s
		lb_try_interval 250ms
		health_uri       /api/health
		health_interval  5s
		health_timeout   3s
		fail_duration    5s
		max_fails        3
	}

	# Transport-level hardening. The APP already sets a strict CSP + security
	# headers via helmet (authoritative); these are belt-and-suspenders.
	header {
		X-Content-Type-Options   nosniff
		# Match the application policy: this private CRM never needs to disclose
		# an internal route or origin in outbound Referer headers.
		Referrer-Policy          no-referrer
		X-Frame-Options          DENY
		-Server                                 # don't advertise the server
		# HSTS: enable ONLY after HTTPS is verified end-to-end (per spec). The app's
		# helmet also emits HSTS in production — if you want to DEFER it until HTTPS
		# is proven, disable it in helmet first, then uncomment here:
		# Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	# Body cap sized to the app's real upload limits so a legit upload never 413s
	# at the proxy: the /join form accepts headshot + license (2 × 10MB) and the
	# lead-photo endpoint 1 × 10MB. 25MB covers both with field/multipart overhead.
	# The app enforces its own per-file limits (multer) below this ceiling.
	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json          # structured access logs (shipped via docker logs)
	}
}

# Fail closed when an HTTPS request reaches this server with a missing,
# malformed, or unexpected authority. In particular, HTTP/2 CONNECT can carry
# an authority that does not select the named portal site; without a catch-all,
# Caddy's empty default route can answer 200 before the portal policy runs.
# Normal portal traffic continues to use the more-specific site block above.
https:// {
	@unsafe_methods method TRACE TRACK CONNECT
	respond @unsafe_methods 405
	respond 421
}

# ── Optional: split the API onto its own host ────────────────────────────────
# The app serves the API and SPA from ONE process, so a separate api. host is
# NOT required. Uncomment only if you later split them; it proxies the same app.
